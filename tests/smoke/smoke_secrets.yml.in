# smoke: secrets (06's envelope encryption, and redaction). Template for gen_secrets.sh,
# which substitutes ENVELOPE for a fresh, per-run `qwe encrypt` blob before every run and
# never commits the result (the blob is key-specific). Do not run this file directly --
# ENVELOPE is not a valid envelope.
name: smoke secrets
secrets:
  TOKEN: !encrypted "ENVELOPE"
jobs:
  secrets:
    target: local
    steps:
      - id: via-env
        env:
          TOKEN: ${{ secrets.TOKEN }}
        run: echo "env says $TOKEN"
      - id: via-with
        uses: file.ensure
        with:
          path: via-with.txt
          content: "${{ secrets.TOKEN }}"
      - run: cat via-with.txt
