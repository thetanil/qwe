# C99, strict warnings for our own code.
build --copt=-std=c99 --copt=-Wall --copt=-Wextra --copt=-Werror
# The warnings beyond -Wall -Wextra (sca-round3/08), for everything except third_party/: the
# vendored code keeps the flags its BUILD files give it, and upstream's style is upstream's.
# -Wfree-nonheap-object comes after the default toolchain's -Wno-free-nonheap-object, so it
# turns the diagnostic back on. -Wswitch-enum is ticket 09's.
build --per_file_copt=.*,-third_party/.*@-Wwrite-strings,-Wcast-qual,-Wsign-conversion,-Wmissing-prototypes,-Wbad-function-cast,-Wfloat-equal,-Wswitch-default,-Wformat=2,-Wpedantic,-Wshadow,-Wconversion,-Warith-conversion,-Wformat-signedness,-Wnull-dereference,-Wduplicated-cond,-Wduplicated-branches,-Wlogical-op,-Wstrict-prototypes,-Wold-style-definition,-Wvla,-Walloca,-Wundef,-Wredundant-decls,-Wcast-align,-Wpointer-arith,-Wjump-misses-init,-Wunused-macros,-Wstrict-overflow=2,-Wdouble-promotion,-Wtrampolines,-Wfree-nonheap-object
# The exec configuration (tools/bcembed.c, the exec build of errstr.c) gets the same set.
build --host_copt=-std=c99 --host_copt=-Wall --host_copt=-Wextra --host_copt=-Werror
build --host_per_file_copt=.*,-third_party/.*@-Wwrite-strings,-Wcast-qual,-Wsign-conversion,-Wmissing-prototypes,-Wbad-function-cast,-Wfloat-equal,-Wswitch-default,-Wformat=2,-Wpedantic,-Wshadow,-Wconversion,-Warith-conversion,-Wformat-signedness,-Wnull-dereference,-Wduplicated-cond,-Wduplicated-branches,-Wlogical-op,-Wstrict-prototypes,-Wold-style-definition,-Wvla,-Walloca,-Wundef,-Wredundant-decls,-Wcast-align,-Wpointer-arith,-Wjump-misses-init,-Wunused-macros,-Wstrict-overflow=2,-Wdouble-promotion,-Wtrampolines,-Wfree-nonheap-object

# The release build: same codegen as the fastbuild default (no --compilation_mode=opt --
# -O2 miscompiled LuaJIT's unwind path on the CI runner in a way that never reproduced
# locally and three targeted fixes did not resolve; see ticket 18's comments and
# third_party/luajit/BUILD), with debug info kept (qwe-debug keeps its DWARF; the strip
# rule still strips qwe). release.yml's build and the smoke workflow's build both use
# this; the full suite runs under it too (05).
build:release --copt=-g

# The warnings at -O2 (sca-round3/08): -Wnull-dereference, -Wstrict-overflow, -Wmaybe-uninitialized,
# -Wformat-truncation and the -Wstringop-* family depend on optimisation passes and are close to
# silent at the default -O0. A build-only check, never shipped (see build:release above); LuaJIT
# keeps the -O0 of its BUILD copts, which come after these. CI: the compiler-warnings job.
build:warnings-o2 --copt=-O2

test --test_output=errors
# ssh e2e tests need the devcontainer's key agent (spec, "Test strategy").
test --test_env=REMOTE_CONTAINERS
test --test_env=SSH_AUTH_SOCK
test --test_env=HOME
test --test_env=QWE_E2E_REQUIRE_SSH

# Sanitizer builds (quality/03). A finding fails the test: no recovery.
# Reports go to files named per pid, so a forked step child's report never
# lands in the stdout/stderr an e2e golden compares (--test_env reaches qwe
# and its children; the harness's scratch dir is removed, so the reports go
# to the test's undeclared-outputs dir, kept when set).
build:ubsan --define=qwe_sanitizer=ubsan
build:ubsan --copt=-fsanitize=undefined,float-cast-overflow --copt=-fno-sanitize-recover=all
build:ubsan --copt=-fno-omit-frame-pointer --copt=-g --strip=never
build:ubsan --linkopt=-fsanitize=undefined,float-cast-overflow
# Vendored code is upstream's to keep clean: LuaJIT shifts into the sign bit on
# purpose (lj_buf.c: 15 << 28). Our own code under src/ is checked in full.
build:ubsan --per_file_copt=third_party/.*@-fno-sanitize=all
test:ubsan --test_env=UBSAN_OPTIONS=print_stacktrace=1:halt_on_error=1

build:asan --define=qwe_sanitizer=asan
build:asan --copt=-fsanitize=address --copt=-fno-sanitize-recover=all
build:asan --copt=-fno-omit-frame-pointer --copt=-g --strip=never
build:asan --linkopt=-fsanitize=address
test:asan --test_env=ASAN_OPTIONS=detect_leaks=1:abort_on_error=0

# Valgrind gate (quality/04). Runs the shipping build, no rebuild with
# instrumentation: every cc_test goes through tools/valgrind/run_under.sh.
build:valgrind --define=qwe_valgrind=1
build:valgrind --copt=-g --strip=never
test:valgrind --run_under=//tools/valgrind:run_under
# short, moderate, long, eternal: only the oom sweeps (timeout = "eternal") need more than 300 s
test:valgrind --test_timeout=300,300,300,3600

# Lua coverage (quality/10): the qwe binary and luarun write lcov for the Lua they run into
# $COVERAGE_DIR, which bazel merges into the combined report with the C.
coverage --test_env=QWE_LUA_COVERAGE=1
coverage --copt=-DQWE_GCOV

# Fuzz targets (quality/06) need clang's libFuzzer. Combine with --config=asan or --config=ubsan.
build:fuzz --repo_env=CC=clang
build:fuzz --action_env=CC=clang
# The warning set above is gcc's: clang has no -Wduplicated-cond, -Wlogical-op,
# -Wjump-misses-init, -Wtrampolines, -Wduplicated-branches or -Warith-conversion, and
# under -Werror an unknown -W name is an error. It checks the ones it knows.
build:fuzz --copt=-Wno-unknown-warning-option --host_copt=-Wno-unknown-warning-option
# LuaJIT on malloc (third_party/luajit/BUILD), so LeakSanitizer can see into the Lua heap.
build:fuzz --define=qwe_fuzz=1
# Coverage feedback for our own code only (src/): third_party (libyaml, LuaJIT) is not fuzzed for now.
build:fuzz --per_file_copt=^src/.*@-fsanitize=fuzzer-no-link

# GCC's static analyzer (ticket sca-round3/07), a second analyzer independent of
# clang-tidy's. Our own code only: third_party is upstream's, and analyzing LuaJIT
# is most of the cost. -Werror above makes any -Wanalyzer-* finding fail the build.
# tools/gcc-analyzer/run.sh runs it against the GCC pinned in tools/gcc-analyzer/pin.env.
build:analyzer --per_file_copt=^src/.*,^tools/.*@-fanalyzer
