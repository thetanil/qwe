{
  "with": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "with: inputs of the apt.package step plugin",
    "type": "object",
    "required": ["name"],
    "additionalProperties": false,
    "properties": {
      "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9+.-]*$", "minLength": 2},
      "state": {"type": "string", "enum": ["present", "absent"]}
    }
  },
  "outputs": {
    "version": {"type": "string", "secret": false}
  }
}
