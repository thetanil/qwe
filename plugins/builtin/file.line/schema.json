{
  "with": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "with: inputs of the file.line step plugin",
    "type": "object",
    "required": ["path", "line"],
    "additionalProperties": false,
    "properties": {
      "path": {"type": "string", "minLength": 1},
      "line": {"type": "string"},
      "state": {"type": "string", "enum": ["present", "absent"]},
      "regexp": {"type": "string", "minLength": 1}
    }
  }
}
