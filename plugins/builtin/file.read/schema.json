{
  "with": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "with: inputs of the file.read step plugin",
    "type": "object",
    "required": ["path"],
    "additionalProperties": false,
    "properties": {
      "path": {"type": "string", "minLength": 1}
    }
  },
  "outputs": {
    "exists": {"type": "boolean", "secret": false},
    "content": {"type": "string", "secret": false},
    "sha256": {"type": "string", "secret": false},
    "mode": {"type": "string", "secret": false},
    "owner": {"type": "string", "secret": false}
  }
}
