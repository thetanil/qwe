{
  "with": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "with: inputs of the file.ensure step plugin",
    "type": "object",
    "required": ["path"],
    "additionalProperties": false,
    "properties": {
      "path": {"type": "string", "minLength": 1},
      "content": {"type": "string"},
      "mode": {"type": "string", "minLength": 1}
    }
  },
  "outputs": {
    "mode": {"type": "string", "secret": false}
  }
}
