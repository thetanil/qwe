# The one file docs/static-analysis.md, docs/ci-checks.md, run.sh and
# .github/actions/clang-tidy-pin all read, so the pinned version is stated once.
#
# CLANG_TIDY_MAJOR is what run.sh enforces locally (a devcontainer's apt-installed
# clang-tidy-20 tracks Ubuntu's llvm-toolchain-noble-20 packaging, which can move to a
# later 20.x point release; checking only the major keeps that clang-tidy usable without
# pinning a developer's machine to a single point release).
#
# CLANG_TIDY_VERSION is the exact version CI installs and measured every finding count
# in docs/static-analysis.md at (rounds 1-3, sca-round3). CLANG_TIDY_URL and
# CLANG_TIDY_SHA256 pin that exact build byte-for-byte: apt.llvm.org only ever serves the
# latest point release of a major, so an apt pin silently drifts forward; LLVM's own
# GitHub release asset, checked against its published sha256, does not.
CLANG_TIDY_MAJOR=20
CLANG_TIDY_VERSION=20.1.8
CLANG_TIDY_URL=https://github.com/llvm/llvm-project/releases/download/llvmorg-20.1.8/LLVM-20.1.8-Linux-X64.tar.xz
CLANG_TIDY_SHA256=1ead36b3dfcb774b57be530df42bec70ab2d239fbce9889447c7a29a4ddc1ae6
